class Solution {
    public int[] numberGame(int[] nums) {
        Arrays.sort(nums);
        int arr[] = new int[nums.length];
        int a=0,b=0;
        int k=0;
        for(int i=0;i<nums.length-1;i+=2)
        {
            a=nums[i];
            b=nums[i+1];
            arr[k++] = b;//2 3 4 5
            arr[k++] = a;
        }
        return arr;
    }
}
