class Solution {
    public int countBinarySubstrings(String s) {
        int l = s.length();
        int z = 0,c = 0, ss = 0;
        List<Integer> al = new ArrayList<>();
        for(int i=0;i<l;i++)
        {
            if(s.charAt(i) - '0' == 0)
            {
                if(c !=0 ){
                    al.add(c);
                    c=0;
                } 
                z++;
            }
            else
            {
                if(z!=0)
                {
                    al.add(z);
                    z = 0; 
                }
                c++;
            }
        }
        if(c > 0 ) al.add(c);
        if(z > 0 ) al.add(z);
        int sum=0;
        for(int i=0;i<al.size()-1;i++)
        {
            sum += Math.min(al.get(i),al.get(i+1));
        }
        return sum;
    }
}
