class NumArray {
    int[] p;
    public NumArray(int[] nums) {
        p = new int[nums.length];
        p[0] = nums[0];
        for(int i=1;i<nums.length;i++)
        {
            p[i] = p[i-1] + nums[i];
        }
    }
    public int sumRange(int left, int right) {
        if(left == 0) return p[right];
        return p[right] - p[left-1];
    }
}
