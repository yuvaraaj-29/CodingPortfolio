class Solution {
    public long maximumSubarraySum(int[] nums, int k) {
        Set<Integer> hs = new LinkedHashSet<>();
        long min = 0;
        long max = 0;
        int j = 0;
        for(int i=0;i<nums.length;i++)
        {
            while(hs.contains(nums[i]))
            {
                hs.remove(nums[j]);
                min-=nums[j];
                j++;
            }
            hs.add(nums[i]);
            min+=nums[i];
            if(i-j+1 > k)
            {
                min-=nums[j];
                hs.remove(nums[j]);
                j++;
            }
            if(i-j+1 == k) max = Math.max(min,max);
        }
        return max;
    }
}
