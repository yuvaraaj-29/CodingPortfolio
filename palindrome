class Solution {
    public boolean isPalindrome(int x) {
        if(x<0){return false;}
        int sum=0,f=x;
        while(x>0){
        int r = x%10;
        x = x/10;
        sum = (sum*10)+r;
        //f=1;
        }
        if(sum==f) return true;
        else return false;


        
        
    }
}
