class Solution {
    public int countGoodSubstrings(String s) {
        int l = s.length();
        if(l<3) return 0;
        int k=3;
        int count=0;
        StringBuilder sb = new StringBuilder();
        for(int i = 0;i<k;i++)
        {
            char c = s.charAt(i);
            sb.append(c);
        }
        if(sb.charAt(0)!=sb.charAt(1)&&sb.charAt(0)!=sb.charAt(2)&&sb.charAt(1)!=sb.charAt(2)) count +=1;
        for(int i=k;i<l;i++)
        {
            sb.append(s.charAt(i));
            sb.deleteCharAt(0);
            if(sb.charAt(0)!=sb.charAt(1)&&sb.charAt(0)!=sb.charAt(2)&&sb.charAt(1)!=sb.charAt(2)) count +=1;
        }
        return count;
    }
}
