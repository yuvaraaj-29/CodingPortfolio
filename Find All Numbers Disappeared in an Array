class Solution {
    public List<Integer> findDisappearedNumbers(int[] nums) {
        List<Integer> al = new ArrayList<>();
        Arrays.sort(nums);
        int c = 0;
        Set<Integer> hs = new LinkedHashSet<>();
        for(int k : nums) hs.add(k);
        for(int i=1;i<nums.length+1;i++)
        {
            if(!hs.contains(i)) al.add(i);
        }
        return al;
    }
}
