class Solution {
    public int divisorSubstrings(int num, int k) {
        String s = String.valueOf(num);
        int l = s.length();
        int count =0;
        if(l<k) return 0;
        StringBuilder sb = new StringBuilder();
        for(int i=0;i<k;i++)
        {
            sb.append(s.charAt(i));
        }
        int n = Integer.parseInt(sb.toString());
        if(num%n == 0) count+=1;
        for(int i=k;i<l;i++)
        {
            sb.append(s.charAt(i));
            sb.deleteCharAt(0);
            if(funcc(sb.toString(),num)) count+=1;
        }
        return count;
    }
    boolean funcc(String s,int num)
    {
        int v = Integer.parseInt(s);
        if(v!=0)
        {
            if(num%v == 0) return true;
        }
        return false;
    }
}
