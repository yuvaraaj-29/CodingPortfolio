class Solution {
    public void setZeroes(int[][] matrix) {
        int n = matrix.length;
        int m = matrix[0].length;
        int i,j,r=0,c=0;
        int[][] mat = new int[n][m];
        for(i=0;i<n;i++)
        {
            for(j=0;j<m;j++)
            {
                mat[i][j] = matrix[i][j];
            }
        }   
        for(i=0;i<n;i++)
        {
            for(j=0;j<m;j++)
            {
                if(matrix[i][j] == 0)
                {
                    for(c=0;c<m;c++)
                    {
                        mat[i][c] = 0;
                    }
                    for(r=0;r<n;r++)
                    {
                        mat[r][j] = 0;
                    }
                }
            }
        }
        for (i = 0; i < n; i++) 
        {
            for (j = 0; j < m; j++) 
            {
                matrix[i][j] = mat[i][j];
            }
        }
    }
}
