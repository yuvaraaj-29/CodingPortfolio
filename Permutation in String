class Solution {
    public boolean checkInclusion(String s1, String s2) {
        int l1 = s1.length();
        int l2 = s2.length();
        StringBuilder sb = new StringBuilder();
        if (l1 > l2) return false;
        for (int i = 0; i < l1; i++) {
            sb.append(s2.charAt(i));
        }
        char[] p = s1.toCharArray();
        Arrays.sort(p);
        String sortedS1 = new String(p);   
        if (funcc(sb.toString(), sortedS1)) return true;

        for (int i = l1; i < l2; i++) {
            sb.append(s2.charAt(i));
            sb.deleteCharAt(0);

            if (funcc(sb.toString(), sortedS1)) return true;
        }
        return false;
    }
    boolean funcc(String s, String d) {
        char[] a = s.toCharArray();
        char[] b = d.toCharArray();
        Arrays.sort(a);
        return Arrays.equals(a, b);
    }
}
