class Solution {
    public int maxProfit(int[] prices) {
        int n = prices.length;
        int min = Integer.MAX_VALUE;
        int r = 0,max=0;
        for(int i=0;i<n;i++)
        {
            if(prices[i]<min)
            {
                min = prices[i];
            }
            r = prices[i] - min;
            if(max < r) max = r;
        }
        return max;
    }
}
