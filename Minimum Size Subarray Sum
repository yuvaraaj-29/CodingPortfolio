class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        int n = nums.length;
        int s=0;
        int min = Integer.MAX_VALUE,sum=0;
        for(int i=0;i<n;i++)
        {
            sum += nums[i];
            while(sum>= target)
            {
                min = Math.min(min,i-s+1);
                sum-=nums[s];
                s++;
            }
        }
        if(min == Integer.MAX_VALUE) return 0;
        return min;
    }
}
