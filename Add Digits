class Solution {
    public int addDigits(int num) {
        if(num <= 9) return num;
        int rem = 0;
        while(num >=10)
        {
            int add =0;
            while(num > 0)
            {
                rem = num%10;
                add+=rem;
                num/=10;
            }
            num = add;
        }
        return num;
    }
}
