class Solution {
    public int lengthOfLastWord(String s) {
        int t = 0,c = 0;
        List<Integer> li = new ArrayList<>();
        for(int i=0;i<s.length();i++)
        {
            if(s.charAt(i) != ' ')
            {
                c+=1;
                if(i==s.length()-1) return c;
            }
            else 
            {
                if(c!=0) li.add(c);
                c=0;
            }
        }
        return li.get(li.size()-1); 
    }
}
