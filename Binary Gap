class Solution {
    public int binaryGap(int n) {
        String s = Integer.toBinaryString(n);
        int max = 0,c=0;
        List<Integer> l = new ArrayList<>();
        for(int i=0;i<s.length();i++)
        {
            if(s.charAt(i) == '1')
            {
                c++;
                l.add(i);
            }
        }
        int m=0;
        for(int i=0;i<l.size()-1;i++)
        {
            m = l.get(i) - l.get(i+1);
            if(m < 0) m *= -1;
            max = Math.max(max,m);
        }
        if(c <= 1) return 0;
        return max;
    }
}
