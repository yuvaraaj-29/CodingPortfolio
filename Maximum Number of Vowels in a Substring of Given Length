class Solution {
    public int maxVowels(String s, int k) {
        int count = 0,max = 0;
        for(int i=0;i<k;i++)
        {
            if(funcc(s.charAt(i))) count+=1;
        }
        max = count;
        for(int i=k;i<s.length();i++)
        {
            if(funcc(s.charAt(i))) count+=1;
            if(funcc(s.charAt(i-k))) count-=1;
            max = Math.max(max,count);
        }
        return max;
    }
    boolean funcc(char c)
    {
        if("aeiouAEIOU".indexOf(c) != -1) return true;
        return false;
    }
}
