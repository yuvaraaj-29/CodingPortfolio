class Solution {
    public int countSegments(String s) {
        StringBuilder sb = new StringBuilder();
        if(s.length() == 0) return 0;
        ArrayList<String> al = new ArrayList<>();
        for(int i=0;i<s.length();i++)
        {
            if(s.charAt(i) != ' ')
            {
                sb.append(s.charAt(i));
            }
            else{
                if(sb.length() == 0) continue;
                if(sb.length() > 0){
                    al.add(sb.toString());
                    sb.setLength(0);
                }
            }
        }
        if(sb.length() > 0){
            al.add(sb.toString());
        }
        return al.size();
    }
}
